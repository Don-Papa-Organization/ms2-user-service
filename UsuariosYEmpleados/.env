# ====== Base de datos (MySQL - Docker Compose o local) ======
DB_HOST=user-mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=MiContraseñaSegura123!
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
DB_INIT_FAIL_TIMEOUT=-1
DB_CONNECTION_TEST_QUERY=SELECT 1

# ====== JPA/Hibernate (MySQL) ======
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
HIBERNATE_HBM2DDL_AUTO=update

# ====== Spring/App ======
SPRING_PROFILES_ACTIVE=development
PORT=4002
LOG_LEVEL=INFO

# Nombre de la base de datos
DB_NAME=don_papa

# ====== Seguridad ======
BCRYPT_ROUNDS=10
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT secrets (cambia en producción)
JWT_SECRET=tu_super_secreto_jwt_development_very_secure_key_12345
JWT_REFRESH_SECRET=tu_super_secreto_jwt_development_very_secure_key_12345

# Internal Service Token
INTERNAL_SERVICE_TOKEN=variablegenerica

