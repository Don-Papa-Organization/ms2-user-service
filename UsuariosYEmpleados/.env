# ====== Base de datos (Azure SQL Server) ======
DB_HOST=user-mysql.database.windows.net
DB_PORT=1433
DB_USERNAME=donpapamaster@user-mysql
DB_PASSWORD=MiContraseñaSegura123!
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
DB_INIT_FAIL_TIMEOUT=-1
DB_CONNECTION_TEST_QUERY=SELECT 1

# ====== JPA/Hibernate (SQL Server) ======
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
HIBERNATE_DIALECT=org.hibernate.dialect.SQLServerDialect
HIBERNATE_HBM2DDL_AUTO=update

# ====== Spring/App ======
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
LOG_LEVEL=INFO

# Nombre de la base de datos (DatabaseConfig)
DB_NAME=don_papa

# ====== Seguridad ======
BCRYPT_ROUNDS=10
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT secrets (cambia en producción)
JWT_SECRET=tu_super_secreto_jwt_development_very_secure_key_12345
JWT_REFRESH_SECRET=tu_super_secreto_jwt_development_very_secure_key_12345

