# ========== DATABASE CONFIGURATION ==========
# MySQL Configuration (Local/Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=don_papa
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Database Connection Pool
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
DB_INIT_FAIL_TIMEOUT=-1
DB_CONNECTION_TEST_QUERY=SELECT 1

# ========== JPA / HIBERNATE CONFIGURATION ==========
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
HIBERNATE_FORMAT_SQL=false
HIBERNATE_HBM2DDL_AUTO=update

# ========== SECURITY CONFIGURATION ==========
# JWT Secrets - MUST be 32+ characters, random and unique
JWT_SECRET=your_very_long_secure_jwt_secret_key_must_be_32_plus_characters
JWT_REFRESH_SECRET=your_very_long_secure_refresh_token_secret_must_be_32_plus_characters

# Internal Service Token
INTERNAL_SERVICE_TOKEN=variablegenerica

# BCrypt Configuration
APP_SECURITY_BCRYPT_ROUNDS=10

# ========== SERVER CONFIGURATION ==========
SERVER_PORT=4002
PORT=4002
SPRING_PROFILES_ACTIVE=development

# ========== LOGGING CONFIGURATION ==========
LOG_LEVEL=INFO

# ========== EXTERNAL SERVICES ==========
EMAIL_SERVICE_URL=http://email-service:4007
